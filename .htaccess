# Enable rewrite engine
RewriteEngine On

# Force HTTPS (for production)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^mechanicafrica\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.mechanicafrica\.com$
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Force non-www
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Redirect index.html to index.php
RewriteRule ^index\.html$ index.php [R=301,L]

# Default index files
DirectoryIndex index.php index.html

# Allow PHP files to be executed
AddType application/x-httpd-php .php

# Security: Deny access to sensitive files
# Block SQLite database file
<Files "contacts.db">
    Order Allow,Deny
    Deny from all
</Files>

# Block .htaccess file itself
<Files ".htaccess">
    Order Allow,Deny
    Deny from all
</Files>

# Block configuration files
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>

<Files "auth-config.php">
    Order Allow,Deny
    Deny from all
</Files>

# Block admin setup/initialization scripts
<Files "init-database.php">
    Order Allow,Deny
    Deny from all
</Files>

<Files "create-super-admin.php">
    Order Allow,Deny
    Deny from all
</Files>

<Files "add-superadmin.php">
    Order Allow,Deny
    Deny from all
</Files>

# Block test files
<Files "test-form.html">
    Order Allow,Deny
    Deny from all
</Files>

# Block backup files
<FilesMatch "\.(bak|backup|old|save|~)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block access to hidden files
<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block access to any .db files
<FilesMatch "\.db$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    
    # Content Security Policy - Allows Google reCAPTCHA and Fonts
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://www.google.com; connect-src 'self';"
    
    # X-Permitted-Cross-Domain-Policies
    Header always set X-Permitted-Cross-Domain-Policies "none"
    
    # HSTS - Enable only after confirming HTTPS works
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# Custom error pages
ErrorDocument 404 /404.html
ErrorDocument 500 /404.html

# Prevent directory browsing
Options -Indexes